# --- ElevenLabs -------------------------------------------------------------
# Create at https://elevenlabs.io/app/settings/api-keys
# Needs Agents (read+write) and Knowledge Base (read+write) permissions.
ELEVENLABS_API_KEY=sk_your_key_here

# One agent per coach, all printed by `npm run setup:agent`. Required —
# nothing is persisted at runtime, so these are how every instance finds the
# same agents.
#
# They are separate agents rather than one agent steered per session because
# the knowledge-base attachment list is per-agent, and that list is what keeps
# each coach inside its own corpus. See src/lib/coaches.ts.
ELEVENLABS_AGENT_ID_ESTRATEGIA=
ELEVENLABS_AGENT_ID_COLEGIOS=
ELEVENLABS_AGENT_ID_EMPRENDEDORES=

# Set once knowledge/gestion-proyectos/ exists and that coach is switched on.
# ELEVENLABS_AGENT_ID_PROYECTOS=

# Legacy, from when there was a single coach. Still read as the fallback for
# ELEVENLABS_AGENT_ID_ESTRATEGIA so an existing deployment does not go dark
# between shipping this and setting the variables above. Remove it once the
# estrategia id is set explicitly.
ELEVENLABS_AGENT_ID=

# --- Auth: operator ---------------------------------------------------------
# Shared secret guarding every knowledge/agent route. Generate with:
#   openssl rand -hex 32
# Routes fail closed if this is unset, in every environment.
INGEST_SECRET=

# --- Supabase: learners, plans, usage ---------------------------------------
# /coach and /api/signed-url require a signed-in learner. Sign-in is Supabase
# Auth with the Google provider; any Google account is accepted. Supabase also
# holds profiles, plans, and the record of every coach session.
#
# Dashboard -> Project Settings -> API. Both of these are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same page, "service_role". SECRET — bypasses row-level security entirely.
# Server-only: writes profiles and usage rows, which learners must not be able
# to forge. Never give this a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Only when the public URL is not what the host header reports — a custom
# domain behind a proxy, say. On Vercel and on localhost, leave it blank.
# NEXT_PUBLIC_SITE_URL=https://tudominio.com
#
# Google itself is configured in the Supabase dashboard
# (Authentication -> Providers -> Google), not here. The redirect URI to
# register with Google is:
#   https://<your-project>.supabase.co/auth/v1/callback

# --- Optional ---------------------------------------------------------------
# Voice used by the coaches. Defaults to Ximena, a mature, vibrant,
# accent-neutral female Spanish voice. A replacement must already be in the
# workspace's My Voices.
ELEVENLABS_VOICE_ID=

# LLM behind the agent. Leave blank to use your workspace default.
ELEVENLABS_AGENT_LLM=claude-sonnet-4-5

# Spoken language: drives speech recognition, the language the coach replies in,
# and which TTS voices are usable. Defaults to Spanish.
ELEVENLABS_AGENT_LANGUAGE=es

# Embedding model for RAG indexing. Changing this requires re-indexing everything,
# and documents left on the old model go silently unreachable.
#   multilingual_e5_large_instruct  -> default; required if the coach and the
#                                      source material are in different languages
#   e5_mistral_7b_instruct          -> slightly better on an English-only corpus
#                                      answered in English
ELEVENLABS_EMBEDDING_MODEL=multilingual_e5_large_instruct

# Apify, for the pain-signal sweeps (`npm run scrape:pains`). Scraping never
# happens in a request, so this is only needed where the script runs — not in
# Vercel.
APIFY_TOKEN=
