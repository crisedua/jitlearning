# --- ElevenLabs -------------------------------------------------------------
# Create at https://elevenlabs.io/app/settings/api-keys
# Needs Agents (read+write) and Knowledge Base (read+write) permissions.
ELEVENLABS_API_KEY=sk_your_key_here

# Printed by `npm run setup:agent`. Required — nothing is persisted at runtime,
# so this env var is how every instance finds the same agent.
ELEVENLABS_AGENT_ID=

# --- Auth -------------------------------------------------------------------
# Shared secret guarding every knowledge/agent route. Generate with:
#   openssl rand -hex 32
# Routes fail closed if this is unset, in every environment.
INGEST_SECRET=

# --- Optional ---------------------------------------------------------------
# Voice used by the coach. Defaults to a stock ElevenLabs voice.
ELEVENLABS_VOICE_ID=

# LLM behind the agent. Leave blank to use your workspace default.
ELEVENLABS_AGENT_LLM=claude-sonnet-4-5

# Spoken language: drives speech recognition, the language the coach replies in,
# and which TTS voices are usable. Defaults to Spanish.
ELEVENLABS_AGENT_LANGUAGE=es

# Embedding model for RAG indexing. Changing this requires re-indexing everything,
# and documents left on the old model go silently unreachable.
#   multilingual_e5_large_instruct  -> default; required if the coach and the
#                                      source material are in different languages
#   e5_mistral_7b_instruct          -> slightly better on an English-only corpus
#                                      answered in English
ELEVENLABS_EMBEDDING_MODEL=multilingual_e5_large_instruct
