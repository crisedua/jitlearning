# --- ElevenLabs -------------------------------------------------------------
# Create at https://elevenlabs.io/app/settings/api-keys
# Needs Agents (read+write) and Knowledge Base (read+write) permissions.
ELEVENLABS_API_KEY=sk_your_key_here

# The teacher's agent, printed by `npm run setup:agent`. Required: nothing is
# persisted at runtime, so this is how every instance finds the same agent.
#
# One product, one agent. If this variable is left over from an earlier version
# of this app, point it at the new agent rather than trusting the name.
ELEVENLABS_AGENT_ID=

# Signing secret for the post-call webhook, which is what turns a finished call
# into the learner's plan and progress.
#
#   ElevenLabs -> Conversational AI -> Settings -> Webhooks
#   URL:    https://<app>.vercel.app/api/webhooks/elevenlabs
#   Events: post_call_transcription
#
# The route refuses every request without this. Sessions still work; the plan
# just stops advancing on its own.
ELEVENLABS_WEBHOOK_SECRET=

# --- Anthropic: the teacher's lookup ------------------------------------------
# Claude with web search, behind /api/ask, registered as an ElevenLabs server
# tool by `npm run setup:tools -- --push`. Without it the teacher still teaches;
# it just cannot answer a question about a current price or job posting, and says
# so rather than guessing.
#
# Create at https://console.anthropic.com/settings/keys
# Goes in Vercel too: the tool calls the deployed route, not your machine.
ANTHROPIC_API_KEY=

# Retrieval strictness, 0 to 1. Overrides TEACHER.maxVectorDistance without a
# deploy. Too tight and the agent retrieves nothing and answers from general
# knowledge in the same confident voice; too loose and loosely related chunks
# get answered from as though they were on point.
# ELEVENLABS_MAX_VECTOR_DISTANCE=0.8

# --- Auth: operator ---------------------------------------------------------
# Shared secret guarding every knowledge/agent route. Generate with:
#   openssl rand -hex 32
# Routes fail closed if this is unset, in every environment.
INGEST_SECRET=

# --- Supabase: learners, plans, usage ---------------------------------------
# /coach and /api/signed-url require a signed-in learner. Sign-in is Supabase
# Auth with the Google provider; any Google account is accepted. Supabase also
# holds profiles, plans, and the record of every coach session.
#
# Dashboard -> Project Settings -> API. Both of these are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same page, "service_role". SECRET — bypasses row-level security entirely.
# Server-only: writes profiles and usage rows, which learners must not be able
# to forge. Never give this a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Only when the public URL is not what the host header reports — a custom
# domain behind a proxy, say. On Vercel and on localhost, leave it blank.
# NEXT_PUBLIC_SITE_URL=https://tudominio.com
#
# Google itself is configured in the Supabase dashboard
# (Authentication -> Providers -> Google), not here. The redirect URI to
# register with Google is:
#   https://<your-project>.supabase.co/auth/v1/callback

# --- Optional ---------------------------------------------------------------
# Voice used by the coaches. Defaults to Ximena, a mature, vibrant,
# accent-neutral female Spanish voice. A replacement must already be in the
# workspace's My Voices.
ELEVENLABS_VOICE_ID=

# LLM behind the agent. Leave blank to use your workspace default.
ELEVENLABS_AGENT_LLM=claude-sonnet-4-5

# Spoken language: drives speech recognition, the language the coach replies in,
# and which TTS voices are usable. Defaults to Spanish.
ELEVENLABS_AGENT_LANGUAGE=es

# Embedding model for RAG indexing. Changing this requires re-indexing everything,
# and documents left on the old model go silently unreachable.
#   multilingual_e5_large_instruct  -> default; required if the coach and the
#                                      source material are in different languages
#   e5_mistral_7b_instruct          -> slightly better on an English-only corpus
#                                      answered in English
ELEVENLABS_EMBEDDING_MODEL=multilingual_e5_large_instruct

# Apify, for the pain-signal sweeps (`npm run scrape:pains`). Scraping never
# happens in a request, so this is only needed where the script runs — not in
# Vercel.
APIFY_TOKEN=

# OpenAI, for the radar IA (`npm run radar` and the "Buscar dolores nuevos"
# button on /admin/radar). Responses API with web search on gpt-5-mini; each
# run costs cents and logs its estimate. Unlike APIFY_TOKEN this one DOES go
# in Vercel too, because the button runs the search server-side.
OPENAI_API_KEY=

# --- Stripe: taking money ----------------------------------------------------
# Nothing below is needed to run the teacher. Without it the paid plans on
# /planes fall back to "conversemos" and only the free tier works.
#
# Secret key from https://dashboard.stripe.com/apikeys (use a test key first:
# sk_test_..., and the card 4242 4242 4242 4242 to walk the whole flow).
STRIPE_SECRET_KEY=

# Signing secret for the webhook, which is the ONLY thing that grants a plan.
# Without it a payment succeeds and the learner stays on the free tier, so
# `npm run doctor` fails when the secret key is set and this is not.
#
#   Stripe -> Developers -> Webhooks -> Add endpoint
#   URL:    https://<app>.vercel.app/api/webhooks/stripe
#   Events: checkout.session.completed
#           customer.subscription.created
#           customer.subscription.updated
#           customer.subscription.deleted
#
# Locally:  stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# One more step that is not an env var: each paid plan needs a recurring Price in
# Stripe, and the checkout refuses to open without one. Do not create them by hand
# in the dashboard — call the deployed app and it creates them from `price_minor`,
# which is what keeps the quoted price and the charged price the same number:
#
#   curl -X POST https://<app>.vercel.app/api/billing/setup \
#     -H "x-ingest-secret: $INGEST_SECRET"
#
# Idempotent, and it will not repoint a price that already exists.

# The canonical public origin, e.g. https://www.modojit.com
#
# Two jobs, one value. `npm run setup:tools` registers the search tool against
# `${PUBLIC_BASE_URL}/api/ask`, and production redirects any other hostname here
# before a request is served. That second part matters for sign-in: this app also
# answers on its .vercel.app alias, Supabase allow-lists OAuth redirect URLs one
# at a time, and a login begun on the alias cannot be completed on the custom
# domain because the PKCE verifier is a cookie bound to the origin that set it.
#
# Unset, neither happens: the tool falls back to a compiled default and no
# redirect is performed. Preview deployments are never redirected.
# PUBLIC_BASE_URL=https://www.modojit.com
