node_modules/
.next/
out/
build/

# Secrets — never commit these
.env
.env.local
.env*.local

.vercel/

*.tsbuildinfo
next-env.d.ts
.DS_Store

# Source material and derived study guides. Book content is copyrighted —
# keep it out of a public repo. Ingested via `npm run ingest -- ./knowledge`.
#
# `knowledge/*` rather than `knowledge/`: git does not descend into an excluded
# directory, so the negation below would never be reached.
knowledge/*

# Exception: the two live corpora are original prose written for this repo —
# syntheses of publicly published frameworks and standards, each document
# naming its sources. No book or manual text is reproduced. Tracked so the
# corpus can be rebuilt, since ElevenLabs holds only a copy taken at upload.
!knowledge/pmp/
!knowledge/empleabilidad/

# Retired corpora stay on disk and out of git: they are no longer ingested,
# and they carry the same copyright caution as any source material.
knowledge/_retired/
