node_modules/
.next/
out/
build/

# Secrets — never commit these
.env
.env.local
.env*.local

.vercel/

*.tsbuildinfo
next-env.d.ts
.DS_Store

# Source material and derived study guides. Book content is copyrighted —
# keep it out of a public repo. Ingested via `npm run ingest -- ./knowledge`.
#
# `knowledge/*` rather than `knowledge/`: git does not descend into an excluded
# directory, so the negation below would never be reached.
knowledge/*

# Exception: `negocio/` is original prose written for this repo — a synthesis of
# publicly published frameworks, with each document naming its sources. No book
# text is reproduced. It is tracked so the corpus can be rebuilt, since
# ElevenLabs holds only a copy taken at upload time.
!knowledge/negocio/

# Same reasoning for `herramientas/`: original prose about how the AI tools
# themselves work, each document naming its official sources and the date it was
# checked. Tracked because it is the corrective for a specific failure — the
# coach denying that a real feature exists — and that has to survive a reclone.
!knowledge/herramientas/

# Same again for `escuela-ia/`: original prose on how a school implements AI,
# built on public guidance (UNESCO, Mineduc, TeachAI) and two named studies that
# contradict each other. Nothing is reproduced from a paywalled source.
!knowledge/escuela-ia/
